# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Retrieval Engine Configuration
# ==========================================
RETRIEVAL_THRESHOLD=0.30
AMBIGUITY_THRESHOLD=0.08
AI_TIMEOUT_MS=20000

# ==========================================
# OPTION 1: Hugging Face Free Serverless API
# ==========================================
# 1. Get a free token from https://huggingface.co/settings/tokens
# 2. Uncomment and populate the lines below:
AI_ENABLED=true
NEMOTRON_API_KEY=hf_your_free_huggingface_token_here
NEMOTRON_BASE_URL=https://router.huggingface.co/hf-inference/v1
NEMOTRON_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# ==========================================
# OPTION 2: NVIDIA Build API (1,000 Free Credits)
# ==========================================
# 1. Get a free key from https://build.nvidia.com/
# 2. Uncomment and populate the lines below:
# AI_ENABLED=true
# NEMOTRON_API_KEY=nvapi-your_nvidia_api_key_here
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
